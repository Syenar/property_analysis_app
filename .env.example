# Supabase server-side credentials (service role must never be exposed to browsers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional deterministic web-search provider for ordinance/source discovery.
# Brave Search is a conventional search API, not an AI dependency.
BRAVE_SEARCH_API_KEY=

# Set to 1 to persist research runs to Supabase.
ENABLE_SUPABASE_PERSISTENCE=0

# Optional declarative configurations for sanctioned public JSON GIS APIs.
# Must be a JSON array. Complex normalizers should be injected in server code instead.
GENERIC_REST_CONFIGS_JSON=[]
