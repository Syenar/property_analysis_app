import { throwIfAborted, rethrowIfAborted } from '../core/abort.mjs';
import { HttpError } from '../core/http.mjs';
import { sourceAuthorityScore } from '../confidence/scoring.mjs';
import { stripHtml } from '../indexing/text-index.mjs';
import { applicableArchiveProviders, archiveProviderSearchQueries, archiveProviderStatus } from './archive-provider-registry.mjs';

const PLAN_SIGNALS = [
  ['blueprint', /\bblueprints?\b/i, 34],
  ['architectural-plan', /\barchitect(?:'s|s)?\s+plans?\b|\barchitectural\s+(?:plans?|drawings?|sheets?)\b/i, 32],
  ['construction-drawings', /\bconstruction\s+(?:plans?|drawings?|documents?|sheets?)\b/i, 31],
  ['structural-plan', /\bstructural\s+(?:plans?|drawings?|sheets?)\b/i, 30],
  ['floor-plan', /\bfloor\s+plans?\b/i, 28],
  ['site-plan', /\bsite\s+plans?\b/i, 26],
  ['permit-plan', /\bpermit\s+(?:plans?|drawings?|set|documents?)\b/i, 25],
  ['plan-set', /\bplan\s*set\b|\bplanset\b/i, 25],
  ['foundation-plan', /\bfoundation\s+plans?\b/i, 23],
  ['elevation', /\b(?:architectural|building)\s+elevations?\b|\beast\s+elevation\b|\bwest\s+elevation\b|\bnorth\s+elevation\b|\bsouth\s+elevation\b/i, 20],
  ['building-plan', /\bbuilding\s+plans?\b/i, 20],
  ['measured-drawing', /\bmeasured\s+drawings?\b/i, 20]
];

const CATALOG_SIGNALS = /archive|archives|archival|library|digital collection|digital collections|catalog|collection|memory project|historic(?:al)? (?:records|collection|archive)|museum|finding aid|historic american buildings survey|\bHABS\b|\bHAER\b/i;
const DIRECT_DOCUMENT_RE = /\.(?:pdf|tiff?|png|jpe?g|gif|webp|dwg|dxf)(?:$|[?#])/i;
const ASSET_ROUTE_RE = /\/(?:assets?|media|files?|downloads?)\/(?:display|original|download|view|content)?\/?[^?#\s]*/i;
const RECORD_ROUTE_RE = /\/(?:nodes?\/view|record|records|item|items|digital\/collection|collections?\/[^/]+\/items?|archive\/items?)\//i;
const NAME_KEY_RE = /(?:^|_)(?:name|building|facility|site|complex|project|landmark|property_name|common_name)(?:$|_)/i;
const ID_KEY_RE = /parcel|apn|pin|folio|account|tax.?id|property.?id/i;

function decodeEntities(value = '') {
  return String(value)
    .replace(/&amp;/gi, '&').replace(/&quot;/gi, '"').replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&nbsp;/gi, ' ')
    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)));
}

function normalize(value) {
  return decodeEntities(String(value || '')).toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
}

function officialHost(url) {
  try {
    const host = new URL(url).hostname.toLowerCase();
    return host.endsWith('.gov') || host.endsWith('.us');
  } catch { return false; }
}

function planSignal(text = '') {
  let best = null;
  for (const [type, re, score] of PLAN_SIGNALS) {
    if (re.test(text) && (!best || score > best.score)) best = { type, score };
  }
  return best;
}

function addressEvidence(text, inputAddress) {
  const input = normalize(inputAddress);
  const hay = normalize(text);
  const house = input.match(/^\d+[a-z]?\b/)?.[0] || null;
  const tokens = input.split(' ').filter((x) => x.length > 2 && !/^\d{5}(?:\d{4})?$/.test(x));
  const streetTokens = tokens.slice(1, 5);
  const houseMatch = house ? new RegExp(`(^| )${house}( |$)`).test(hay) : false;
  const streetMatches = streetTokens.filter((t) => hay.includes(t)).length;
  return { matched:Boolean(houseMatch && streetMatches >= Math.min(2, streetTokens.length || 2)), houseMatch, streetMatches };
}

function cleanedTitle(value = '') {
  let title = decodeEntities(String(value || '')).replace(/\s+/g, ' ').trim();
  title = title.replace(/\s+[|—–]\s+(?:Arizona Memory Project|Library of Congress|National Park Service|.*(?:Archives?|Library|Museum))$/i, '').trim();
  return title.slice(0, 180);
}

function propertyAliasesFromParcel(parcel) {
  const rows = [];
  for (const [key, value] of Object.entries(parcel?.properties || {})) {
    if (value == null || typeof value === 'object') continue;
    const text = String(value).replace(/\s+/g, ' ').trim();
    if (text.length < 4 || text.length > 120) continue;
    if (NAME_KEY_RE.test(String(key).replace(/\s+/g, '_'))) rows.push({ value:text, source:`parcel:${key}`, confidence:90 });
    else if (/(owner|agency|department)/i.test(key) && /\b(?:state|county|city|town|village|university|authority|district)\b/i.test(text)) rows.push({ value:text, source:`parcel:${key}`, confidence:55 });
  }
  return dedupeAliases(rows);
}

function parcelIdentifiers(parcel) {
  const rows = [];
  for (const [key, value] of Object.entries(parcel?.properties || {})) {
    if (!ID_KEY_RE.test(key) || value == null || typeof value === 'object') continue;
    const text = String(value).trim();
    if (text.length >= 3 && text.length <= 80) rows.push({ key, value:text });
  }
  return rows.slice(0, 6);
}

function dedupeAliases(rows) {
  const map = new Map();
  for (const row of rows || []) {
    const key = normalize(row.value);
    if (!key || key.length < 4) continue;
    const current = map.get(key);
    if (!current || (row.confidence || 0) > (current.confidence || 0)) map.set(key, row);
  }
  return [...map.values()].slice(0, 12);
}


function freshAnonymousId() {
  if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
  // UUID-format fallback used only as an anonymous public-catalog session identifier.
  return '00000000-0000-4000-8000-' + Math.random().toString(16).slice(2).padEnd(12, '0').slice(0, 12);
}

function materialTabDescription(row) {
  return (row?.materialTabs || []).map((tab) => decodeEntities(tab?.description || '')).filter(Boolean).join(' ');
}

function materialTabUrls(row) {
  const urls = [];
  for (const tab of row?.materialTabs || []) {
    for (const url of tab?.availability?.urls || []) if (url) urls.push(String(url));
  }
  return [...new Set(urls)];
}

function materialTabRecordIds(row) {
  const ids = [];
  for (co